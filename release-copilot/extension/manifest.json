{
  "manifest_version": 3,
  "name": "StreamPack Release Copilot",
  "short_name": "Release Copilot",
  "version": "0.1.0",
  "description": "Prepare your release once, then fill the DistroKid and RouteNote upload forms in one click. You always review and submit.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Release Copilot"
  },
  "side_panel": {
    "default_path": "panel/panel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "sidePanel",
    "activeTab"
  ],
  "host_permissions": [
    "https://distrokid.com/*",
    "https://*.distrokid.com/*",
    "https://routenote.com/*",
    "https://*.routenote.com/*",
    "https://streampack.pages.dev/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://distrokid.com/*",
        "https://*.distrokid.com/*",
        "https://routenote.com/*",
        "https://*.routenote.com/*"
      ],
      "js": [
        "i18n.js",
        "adapters/distrokid.js",
        "adapters/routenote.js",
        "filler.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icons/icon-32.png"
      ],
      "matches": [
        "https://*.distrokid.com/*",
        "https://distrokid.com/*",
        "https://*.routenote.com/*",
        "https://routenote.com/*"
      ]
    }
  ]
}