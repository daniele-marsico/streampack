{
  "manifest_version": 3,
  "name": "UploadMySong – Release Copilot",
  "short_name": "UploadMySong",
  "version": "0.2.0",
  "description": "Prepare your song release once, then copy every field into DistroKid, RouteNote, TuneCore or CD Baby in order. Checks the mistakes that get releases rejected.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "UploadMySong"
  },
  "side_panel": {
    "default_path": "panel/panel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "sidePanel",
    "clipboardWrite"
  ],
  "host_permissions": [
    "https://streampack.pages.dev/*",
    "https://uploadmysong.controllinghub.com/*"
  ]
}